{
  "name": "dsh-armory",
  "version": "1.9.3",
  "description": "Unified Skill + MCP + Expert board for DeepSeek Harness (desktop app and Web GUI) — global panel page, JSON import, WorkBuddy connector & SkillHub & Expert market installs, tool-usage tailor, and profile-backed Host Remote management.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2026heshao/dsh-armory.git"
  },
  "homepage": "https://github.com/2026heshao/dsh-armory#readme",
  "bugs": {
    "url": "https://github.com/2026heshao/dsh-armory/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node ./test/run-all.mjs",
    "test:expert": "node ./test/run-expert-manual.mjs",
    "test:upgrade": "node ./test/upgrade-plan.mjs",
    "test:install": "node ./test/verify-install-info.mjs",
    "test:e2e": "node ./test/run-e2e.mjs",
    "migrate": "node ./test/run.mjs migrate"
  },
  "exports": {
    "./typert": "./lib/typert.js",
    "./client": "./lib/client.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs/*.md",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "smol-toml": "^1.8.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-scope": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-loader": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "mcp",
    "mcp-client",
    "armory",
    "skill",
    "skill-manager",
    "expert",
    "agent-preset",
    "workbuddy",
    "plugin"
  ],
  "license": "MIT"
}
